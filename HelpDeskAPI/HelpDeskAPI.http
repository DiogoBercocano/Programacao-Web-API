@host = https://localhost:7257

### ===================== AUTH =====================

### Login - administrador
# @name loginAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@empresa.com",
  "senha": "Admin@123"
}

### Login - técnico
# @name loginTecnico
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "carla.mendes@empresa.com",
  "senha": "Senha@123"
}

### Login - solicitante
# @name loginSolicitante
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "ana.souza@empresa.com",
  "senha": "Senha@123"
}

### Auth - usuário logado
GET {{host}}/api/auth/me
Authorization: Bearer {{loginAdmin.response.body.token}}

### ===================== USUARIOS =====================

### Usuarios - listar todos
GET {{host}}/api/usuarios
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Usuarios - filtro por perfil
GET {{host}}/api/usuarios?perfil=Tecnico
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Usuarios - filtro por ativo
GET {{host}}/api/usuarios?ativo=true
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Usuarios - buscar por id
GET {{host}}/api/usuarios/1
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Usuarios - criar
POST {{host}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nome": "Fernanda Alves",
  "email": "fernanda.alves@empresa.com",
  "senha": "Senha@123",
  "setor": "RH",
  "perfil": "Solicitante",
  "ativo": true
}

### Usuarios - atualizar
PUT {{host}}/api/usuarios/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nome": "Ana Souza",
  "email": "ana.souza@empresa.com",
  "setor": "Financeiro",
  "perfil": "Solicitante",
  "ativo": true
}

### Usuarios - excluir
DELETE {{host}}/api/usuarios/5
Authorization: Bearer {{loginAdmin.response.body.token}}

### ===================== CHAMADOS =====================

### Chamados - listar todos
GET {{host}}/api/chamados
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Chamados - filtro por status
GET {{host}}/api/chamados?status=Aberto
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Chamados - filtro por prioridade
GET {{host}}/api/chamados?prioridade=Critica
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Chamados - buscar por id
GET {{host}}/api/chamados/1
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Chamados - criar (solicitante)
POST {{host}}/api/chamados
Content-Type: application/json
Authorization: Bearer {{loginSolicitante.response.body.token}}

{
  "titulo": "Impressora sem toner",
  "descricao": "A impressora do setor financeiro esta sem toner ha dois dias.",
  "categoria": "Hardware",
  "prioridade": "Media",
  "solicitanteId": 1
}

### Chamados - atualizar (técnico)
PUT {{host}}/api/chamados/1
Content-Type: application/json
Authorization: Bearer {{loginTecnico.response.body.token}}

{
  "titulo": "Computador não liga",
  "descricao": "Ao pressionar o botao de energia, o computador nao apresenta nenhuma resposta.",
  "categoria": "Hardware",
  "prioridade": "Alta",
  "status": "EmAtendimento",
  "solicitanteId": 1,
  "tecnicoId": 3
}

### Chamados - excluir
DELETE {{host}}/api/chamados/1
Authorization: Bearer {{loginAdmin.response.body.token}}

### ===================== INTERACOES =====================

### Interacoes - listar
GET {{host}}/api/chamados/2/interacoes
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

### Interacoes - criar (técnico; o autor vem do token)
POST {{host}}/api/chamados/2/interacoes
Content-Type: application/json
Authorization: Bearer {{loginTecnico.response.body.token}}

{
  "mensagem": "Técnico iniciou o atendimento.",
  "interna": false
}

### Interacoes - excluir
DELETE {{host}}/api/chamados/2/interacoes/2
Authorization: Bearer {{loginAdmin.response.body.token}}
